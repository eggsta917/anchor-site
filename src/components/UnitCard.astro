---
import type { Listing } from '../lib/appfolio';
import type { Lang } from '../i18n';
import { useT } from '../i18n';
interface Props { u: Listing; lang?: Lang; openIncome?: boolean; planSrc?: string }
const { u, lang = 'en', openIncome = false, planSrc } = Astro.props;
const s = useT(lang);
const rent = u.rent > 0 ? `$${u.rent.toLocaleString()}` : '$[RENT]';
const avail = u.availableOn ? new Date(u.availableOn + 'T12:00:00').toLocaleDateString(lang === 'ja' ? 'ja-JP' : 'en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '';
const spec = [`${u.bedrooms} bd`, `${u.bathrooms} ba`, u.squareFeet ? `${u.squareFeet} sq ft` : null, u.address].filter(Boolean).join(' · ');
---
<article class="card">
  <div class="card-media">
    {u.photos[0] && <img src={u.photos[0].thumb} alt={`${u.propertyName} ${u.unit}`} loading="lazy" />}
    <span class="chip">{u.bedrooms} {lang === 'ja' ? 'ベッド' : 'bedroom'}</span>
  </div>
  <div class="card-body">
    <h3>{u.propertyName}</h3>
    <p class="muted" style="font-size: 14px;">{spec}</p>
    <p class="price">{rent}<small> {s.units.mo}</small></p>
    <p class="muted" style="font-size: 13px;">{s.units.available} {avail}</p>
    <p style="font-size: 12px; font-weight: 600; margin-bottom: 14px; color: var(--teal);">{openIncome ? s.how.openTag : s.how.qualTag}</p>
    <div style="display: flex; gap: 8px; margin-top: auto;">
      <a href={u.applicationUrl} class="btn btn-primary" style="flex: 1;" rel="noopener">{s.units.apply}</a>
      {planSrc && <a href={planSrc} data-lightbox data-caption={`${u.propertyName} · ${u.bedrooms} bedroom floor plan`} class="btn btn-outline" aria-label="Floor plan" style="padding-inline: 14px;"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"></rect><path d="M3 12h9V3M12 12v9"></path></svg>{lang === 'ja' ? '間取り' : 'Plan'}</a>}
    </div>
  </div>
</article>
