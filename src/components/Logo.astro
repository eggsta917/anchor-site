---
import mark from '../assets/logo-mark.svg?raw';
import horizontal from '../assets/logo-horizontal.svg?raw';
import stacked from '../assets/logo-stacked.svg?raw';
interface Props { variant?: 'mark' | 'horizontal' | 'stacked'; height?: number; class?: string }
const { variant = 'horizontal', height = 44, class: cls = '' } = Astro.props;
const svg = variant === 'mark' ? mark : variant === 'stacked' ? stacked : horizontal;
const ratio = variant === 'mark' ? 1 : variant === 'stacked' ? 239.33 / 221.8 : 217.55 / 70.09;
const width = Math.round(height * ratio);
---
<span class={`logo ${cls}`} role="img" aria-label="Anchor Rentals" style={`display: inline-flex; width: ${width}px; height: ${height}px; color: inherit;`} set:html={svg.replace('<svg ', `<svg width="${width}" height="${height}" aria-hidden="true" focusable="false" `)} />
