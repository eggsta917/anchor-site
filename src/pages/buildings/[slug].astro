---
import Base from '../../layouts/Base.astro';
import UnitCard from '../../components/UnitCard.astro';
import Waitlist from '../../components/Waitlist.astro';
import { buildings, planFor } from '../../data/buildings';
import BuildingsMap from '../../components/BuildingsMap.astro';
import { getListings } from '../../lib/appfolio';

export function getStaticPaths() {
  return buildings.map((b) => ({ params: { slug: b.slug }, props: { b } }));
}
const { b } = Astro.props;
const listings = (await getListings()).filter((u) => u.propertyName === b.name || u.address.startsWith(b.address.split(',')[0]));
const mapUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(b.address)}`;
---
<Base title={b.name} description={b.blurb} showBanner={false}>
  <section class="section wrap">
    <div class="split split-even" style="align-items: start;">
      <div>
        <p class="eyebrow">{b.area}{b.units ? ` · ${b.units} apartments` : ''}</p>
        <h1 style="margin-bottom: 12px;">{b.name}</h1>
        <p class="muted" style="margin-bottom: 20px;"><a href={mapUrl} rel="noopener" target="_blank">{b.address}</a></p>
        <p class="lede" style="margin-bottom: 24px;">{b.blurb}</p>
        <dl style="display: grid; grid-template-columns: auto 1fr; gap: 8px 20px; font-size: 15px;">
          <dt class="muted">Completed</dt><dd style="margin: 0;">{b.completed}</dd>
          {b.mix && <><dt class="muted">Unit mix</dt><dd style="margin: 0;">{b.mix}</dd></>}
          {b.parking && <><dt class="muted">Parking</dt><dd style="margin: 0;">{b.parking}</dd></>}
          <dt class="muted">Income limit</dt><dd style="margin: 0;">{b.openIncome ? <>Most units ≤ 80% AMI; a limited number open to all incomes · <a href="/eligibility/">details</a></> : <>≤ 80% AMI · <a href="/eligibility/">see table</a></>}</dd>
          <dt class="muted">Status</dt><dd style="margin: 0; font-weight: 600; color: var(--teal);">{b.statusLabel}</dd>
        </dl>
      </div>
      <div style="background: var(--teal-pale); border-radius: 24px; min-height: 320px; position: relative; overflow: hidden;">
        <img src={`/images/${b.slug}.jpg`} alt={`${b.name} exterior`} style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;" onerror="this.remove()" />
      </div>
    </div>
  </section>

  {(b.plans?.length || b.videoId) && (
    <section class="section" style="background: var(--white); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line);">
      <div class="wrap">
        <p class="eyebrow">Plans &amp; tour</p>
        <h2 style="margin-bottom: 28px;">Inside {b.name}</h2>
        <div class="split split-even" style="align-items: start;">
          {b.videoId && (
            <div style="aspect-ratio: 16 / 9; border-radius: var(--radius-lg); overflow: hidden; background: var(--teal-pale);">
              <iframe src={`https://www.youtube-nocookie.com/embed/${b.videoId}`} title={`${b.name} walkthrough`} style="width: 100%; height: 100%; border: 0;" allow="accelerometer; encrypted-media; gyroscope; picture-in-picture" allowfullscreen loading="lazy"></iframe>
            </div>
          )}
          {b.plans?.map((pl) => (
            <figure style="margin: 0;">
              <a href={pl.src} data-lightbox data-caption={pl.caption}><img src={pl.src} alt={`${b.name} floor plan`} style="border-radius: var(--radius-lg); border: 1px solid var(--line); width: 100%;" loading="lazy" /></a>
              <figcaption class="muted" style="font-size: 13px; margin-top: 10px; line-height: 1.5;">{pl.caption} <span style="white-space: nowrap;">Tap to enlarge.</span></figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  {listings.length > 0 && (
    <section class="section band-dark">
      <div class="wrap">
        <p class="eyebrow" style="color: var(--gold);">Now leasing</p>
        <h2 style="margin-bottom: 28px;">Available at {b.name}</h2>
        <div class="grid grid-3">{listings.map((u) => <UnitCard u={u} openIncome={b.openIncome} planSrc={planFor(u.propertyName, u.bedrooms)} />)}</div>
      </div>
    </section>
  )}

  <section class="section wrap">
    <p class="eyebrow">Location</p>
    <h2 style="margin-bottom: 20px;">Getting there</h2>
    <BuildingsMap height="380px" focus={b.slug} />
  </section>

  <Waitlist propertyId={b.slug} />
</Base>
