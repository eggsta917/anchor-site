---
import Base from '../layouts/Base.astro';
import UnitCard from '../components/UnitCard.astro';
import Waitlist from '../components/Waitlist.astro';
import { getListings } from '../lib/appfolio';
const listings = await getListings();
---
<Base title="Available units" showBanner={false}>
  <section class="section wrap">
    <p class="eyebrow">Now leasing</p>
    <h1 style="margin-bottom: 12px;">Available units</h1>
    <p class="lede" style="margin-bottom: 32px;">Every unit listed here is income-qualified: your household must earn at or below 80% of Honolulu's area median income. <a href="/eligibility/">Check the limits</a> before you apply.</p>
    {listings.length ? (
      <div class="grid grid-3">{listings.map((u) => <UnitCard u={u} />)}</div>
    ) : (
      <p class="lede">Nothing is open at the moment. Join the waitlist below and we'll text you first.</p>
    )}
  </section>
  <Waitlist />
</Base>
