# AppFolio Database API v0 (Plus + Database API). Leave the credentials blank to use mock data.
# Docs: https://developer.appfolio.com/api_documentation/database
APPFOLIO_CLIENT_ID=
APPFOLIO_CLIENT_SECRET=
APPFOLIO_DEVELOPER_ID=    # Developer Space -> Admin -> Developer ID (shown on the credential page)
APPFOLIO_DATABASE_ID=     # shown on the OAuth credential page; not needed when APPFOLIO_AUTH=basic
# APPFOLIO_AUTH=oauth     # or "basic" for the deprecated HTTP Basic credentials (retired March 1, 2027)
# APPFOLIO_PROPERTY_IDS={"makiki-banyan":"<AppFolio property uuid>"}   # optional; otherwise matched by address
# APPFOLIO_DEFAULT_PROPERTY_ID=   # optional: property that receives leads with no building chosen
APPFOLIO_DATABASE=        # your AppFolio subdomain, e.g. oceansrealestate (used for portal links only)

# Where the public application / portals live (AppFolio-hosted)
PUBLIC_APPLY_URL=https://example.appfolio.com/listings
PUBLIC_RESIDENT_PORTAL_URL=https://example.appfolio.com/connect
PUBLIC_OWNER_PORTAL_URL=https://example.appfolio.com/oportal

# Set to true at launch: removes noindex and opens robots.txt
PUBLIC_SITE_LIVE=false
