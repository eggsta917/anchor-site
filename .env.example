# AppFolio Database API (Plus + Database API add-on). Leave blank to use mock data.
APPFOLIO_CLIENT_ID=
APPFOLIO_CLIENT_SECRET=
APPFOLIO_DATABASE=        # your AppFolio subdomain, e.g. oceansrealestate
APPFOLIO_API_BASE=https://api.appfolio.com   # confirm against the enablement docs

# Where the public application / portals live (AppFolio-hosted)
PUBLIC_APPLY_URL=https://example.appfolio.com/listings
PUBLIC_RESIDENT_PORTAL_URL=https://example.appfolio.com/connect
PUBLIC_OWNER_PORTAL_URL=https://example.appfolio.com/oportal

# Set to true at launch: removes noindex and opens robots.txt
PUBLIC_SITE_LIVE=false
